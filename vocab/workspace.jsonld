      },
      "skos:prefLabel": {
        "@value": "workspace",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "development environment that keeps its sessions, files, agents and history together and restores them after a restart",
        "@language": "en"
      },
      "skos:altLabel": {
        "@value": "bench",
        "@language": "en"
      },
      "skos:hiddenLabel": [
        {
