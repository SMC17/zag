          "@language": "en"
        },
        {
          "@value": "environment group",
          "@language": "en"
        }
      ],
      "skos:broader": {
        "@id": "https://zag.dev/vocab/workspace/development-environment"
      },
      "skos:example": {
        "@value": "the workspace that holds the parser branch, its three sessions and its review agent",
        "@language": "en"
      },
      "dcterms:subject": "software engineering",
