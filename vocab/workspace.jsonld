      "skos:prefLabel": {
        "@value": "redaction",
        "@language": "en"
      },
      "skos:definition": {
        "@value": "replacement of a credential in text by a placeholder that names its kind, done before the text becomes a record or leaves the machine",
        "@language": "en"
      },
      "skos:altLabel": {
        "@value": "masking",
        "@language": "en"
      },
      "skos:hiddenLabel": {
