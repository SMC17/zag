        "correlation": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "payload": {
          "$ref": "#/$defs/WorkspaceEvent"
        },
        "contentHash": {
          "type": "string"
        },
        "chainHash": {
          "type": "string"
        }
