{
  "openapi": "3.1.0",
  "info": {
    "title": "zag workspace daemon",
    "version": "0.1.0",
    "summary": "Read and drive a workspace over HTTP.",
    "license": {
      "name": "MIT"
    }
  },
  "servers": [
    {
      "url": "http://127.0.0.1:7717",
      "description": "Local workspace daemon"
    }
  ],
  "paths": {
    "/health": {
      "get": {
        "operationId": "getHealth",
        "summary": "Report whether the daemon is running",
        "tags": [
          "system"
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": {
                      "type": "string"
                    },
                    "version": {
                      "type": "string"
                    },
                    "pseudoterminalSupported": {
                      "type": "boolean"
                    }
                  },
                  "required": [
                    "status",
                    "version",
                    "pseudoterminalSupported"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The caller does not hold the required capability"
          }
        }
      }
    },
    "/sessions": {
      "get": {
        "operationId": "listSessions",
        "summary": "List the sessions in this workspace",
        "tags": [
          "sessions"
        ],
        "x-zag-capability": "fs.read",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sessions": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Session"
                      }
                    }
                  },
                  "required": [
                    "sessions"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The caller does not hold the required capability"
          }
        }
      }
    },
    "/sessions/{sessionId}/blocks": {
      "get": {
        "operationId": "listBlocks",
        "summary": "List the blocks in one session",
        "tags": [
          "sessions"
        ],
        "x-zag-capability": "fs.read",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "blocks": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Block"
                      }
                    }
                  },
                  "required": [
                    "blocks"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The caller does not hold the required capability"
          }
        }
      }
    },
    "/sessions/{sessionId}/commands": {
      "post": {
        "operationId": "submitCommand",
        "summary": "Run a command in one session",
        "tags": [
          "sessions"
        ],
        "x-zag-capability": "process.execute",
        "parameters": [
          {
            "name": "sessionId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "commandText": {
                    "type": "string"
                  },
                  "workingDirectory": {
                    "type": "string"
                  }
                },
                "required": [
                  "commandText",
                  "workingDirectory"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string"
                    },
                    "session": {
                      "type": "string"
                    },
                    "kind": {
                      "$ref": "#/components/schemas/Kind"
                    },
                    "status": {
                      "$ref": "#/components/schemas/Status"
                    },
                    "createdAt": {
                      "type": "string"
                    },
                    "startedAt": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "finishedAt": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "workingDirectory": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "commandText": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "exitStatus": {
                      "anyOf": [
                        {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 255
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "actor": {
                      "$ref": "#/components/schemas/Actor"
                    },
                    "content": {
                      "$ref": "#/components/schemas/ContentRef"
                    },
                    "git": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/GitContext"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "environment": {
                      "anyOf": [
                        {
                          "$ref": "#/components/schemas/EnvironmentFingerprint"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "parent": {
                      "anyOf": [
                        {
                          "type": "string"
                        },
                        {
                          "type": "null"
                        }
                      ]
                    },
                    "children": {
                      "type": "array",
                      "items": {
                        "type": "string"
                      }
                    },
                    "boundaryFromShell": {
                      "type": "boolean"
                    },
                    "outputBytes": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "session",
                    "kind",
                    "createdAt",
                    "actor"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The caller does not hold the required capability"
          }
        }
      }
    },
    "/events": {
      "get": {
        "operationId": "listEvents",
        "summary": "Read the workspace event log from a sequence number",
        "tags": [
          "events"
        ],
        "x-zag-capability": "fs.read",
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "events": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/Envelope"
                      }
                    },
                    "nextSequence": {
                      "type": "integer",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "events",
                    "nextSequence"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The caller does not hold the required capability"
          }
        }
      }
    },
    "/approvals/{approvalId}": {
      "post": {
        "operationId": "answerApproval",
        "summary": "Answer a request that is waiting for a person",
        "tags": [
          "approvals"
        ],
        "x-zag-capability": "process.execute",
        "parameters": [
          {
            "name": "approvalId",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "outcome": {
                    "type": "string"
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "required": [
                  "outcome",
                  "note"
                ],
                "additionalProperties": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "accepted": {
                      "type": "boolean"
                    },
                    "message": {
                      "type": "string"
                    }
                  },
                  "required": [
                    "accepted",
                    "message"
                  ],
                  "additionalProperties": false
                }
              }
            }
          },
          "403": {
            "description": "The caller does not hold the required capability"
          }
        }
      }
    }
  },
